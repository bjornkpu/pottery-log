:3000 {
	root * /srv

	encode zstd gzip

	# Must precede the SPA fallback — try_files is ordered before handle,
	# so a top-level fallback would rewrite /health away before it matches
	handle /health {
		respond "OK" 200
	}

	handle {
		# Hashed assets — immutable (Vite content-hashes filenames)
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# Everything else must stay fresh: index.html and deep links reference
		# hashed assets, config.js changes per deployment, and the service
		# worker decides when updates apply
		@volatile not path /assets/*
		header @volatile Cache-Control "no-store"

		# SPA fallback: serve file if exists, otherwise index.html
		try_files {path} /index.html
		file_server
	}
}
